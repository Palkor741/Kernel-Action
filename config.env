KBUILD_BUILD_USER=Valcore
KBUILD_BUILD_HOST=github
KERNEL_SOURCE=https://github.com/Palkor741/Sw-kernel-base
KERNEL_SOURCE_BRANCH=shockwave-slmk
KERNEL_DEFCONFIG=merlin_defconfig
TARGET_ARCH=arm64
KERNEL_FILE=Image.gz-dtb
EXTRA_BUILD_COMMAND: CC=clang KCFLAGS="-Wno-error -Wno-deprecated-non-prototype -Wno-strict-prototypes -Wno-single-bit-bitfield-constant-conversion -Wno-default-const-init-var-unsafe -Wno-implicit-int -Wno-incompatible-pointer-types" READELF=llvm-readelf OBJCOPY=llvm-objcopy LD=ld.lld NM=llvm-nm OBJDUMP=llvm-objdump STRIP=llvm-strip CROSS_COMPILE_ARM32=arm-linux-androideabi-
NEED_DTBO=true
MAKE_BOOT_IMAGE=true
USE_KERNELSU=false
