KBUILD_BUILD_USER=Valcore
KBUILD_BUILD_HOST=github
KERNEL_SOURCE=https://github.com/Palkor741/shas-dream-oc-mt6768-a11
KERNEL_SOURCE_BRANCH=eleven
KERNEL_DEFCONFIG=merlin_defconfig
TARGET_ARCH=arm64
KERNEL_FILE=Image.gz-dtb
EXTRA_BUILD_COMMAND: CC=clang LLVM_IAS=1 KCFLAGS="-Wno-error -Wno-deprecated-non-prototype -Wno-default-const-init-var-unsafe -Wno-strict-prototypes -Wno-single-bit-bitfield-constant-conversion -Wno-implicit-int -Wno-incompatible-pointer-types -Wno-incompatible-function-pointer-types -Wno-int-conversion -Wno-implicit-function-declaration -Wno-unused-but-set-variable -Wno-array-compare" READELF=llvm-readelf OBJCOPY=llvm-objcopy LD=ld.lld NM=llvm-nm OBJDUMP=llvm-objdump STRIP=llvm-strip CROSS_COMPILE_ARM32=arm-none-linux-gnueabihf-
NEED_DTBO=false
MAKE_BOOT_IMAGE=false
USE_KERNELSU=true
